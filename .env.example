# ============================================================================
# BIẾN MÔI TRƯỜNG CỦA HỆ THỐNG GIAO HÀNG NEM NÚI
# ============================================================================
# Sao chép nội dung file này thành file .env.local và điền các giá trị thực tế

# 1. CẤU HÌNH TELEGRAM BOT (Gửi thông báo đơn mới tức thì)
# Lấy BOT_TOKEN từ @BotFather trên Telegram:
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Lấy CHAT_ID từ @userinfobot hoặc @RawDataBot (chat ID của bạn hoặc Group của quán):
TELEGRAM_CHAT_ID="-1001234567890"

# 2. CẤU HÌNH SUPABASE (Lưu trữ đơn hàng an toàn)
# Lấy từ Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
# CHÚ Ý: Sử dụng SERVICE_ROLE_KEY (Secret Key) để ghi đơn hàng an toàn qua RLS
# Tuyệt đối không dùng Anon Key và không để lộ Key này ra Client
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
