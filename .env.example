# ============================================================================
# BIẾN MÔI TRƯỜNG CỦA HỆ THỐNG GIAO HÀNG NEM NÚI
# ============================================================================
# Sao chép nội dung file này thành file .env.local và điền các giá trị thực tế

# 1. XÁC THỰC QUẢN TRỊ & BẾP
ADMIN_PIN="99887766"
ADMIN_SECRET="your_admin_secret_key"

# 2. CẤU HÌNH SUPABASE (Lưu trữ đơn hàng & Realtime WebSocket)
# Lấy từ Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_secret_key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key"

# 3. CẤU HÌNH THÔNG BÁO DISCORD WEBHOOK (Gửi đơn hàng tức thì về kênh Discord)
# Lấy từ: Discord Server -> Channel Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"

# 4. WEBHOOK GOOGLE SHEETS (Tùy chọn - Đồng bộ lead & đơn hàng sang Google Sheets)
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your_script_id/exec"
